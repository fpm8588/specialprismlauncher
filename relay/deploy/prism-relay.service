# Runs prism-relay on Linux (Ubuntu). Install: see "Running on Linux" in relay/README.md.
[Unit]
Description=Prism relay
After=network-online.target
Wants=network-online.target

[Service]
User=prismrelay
Group=prismrelay
ExecStart=/opt/prism-relay/prism-relay -data-dir /var/lib/prism-relay -no-browser -admin-addr 192.168.0.127:9777
Restart=on-failure
RestartSec=5
# Lets the program listen on ports below 1024 (80 and 443) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/prism-relay

[Install]
WantedBy=multi-user.target
